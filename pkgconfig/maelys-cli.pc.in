prefix=@PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include
agentsdir=${prefix}/share/maelys-cli/agents
embed=${prefix}/bin/maelys-cli-embed
reference=${prefix}/bin/maelys-cli-reference
commandsdir=${prefix}/share/maelys/commands

Name: maelys-cli
Description: Shared Maelys command-line framework core: catalog, parser, renderer (no dependency)
Version: @VERSION@
Libs: -L${libdir} -lmaelys_cli
Cflags: -I${includedir}
