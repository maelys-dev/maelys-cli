#!/bin/sh
# Embeds files (JSON Schemas, Markdown, any text) into C symbols so a CLI
# binary stays self-contained.
#
# usage: maelys-cli-embed [--header] [--define NAME=VALUE]... SYMBOL=FILE...
#
# Without --header, prints definitions:  const char SYMBOL[] = { ..., 0 };
# With --header, prints declarations:    extern const char SYMBOL[];
# --define replaces every literal @NAME@ occurrence before embedding.
set -eu

encode_bytes() {
    LC_ALL=C od -An -v -tu1 | awk '
        { for (i = 1; i <= NF; i++) {
              if (seen++) printf ","
              printf "%s", $i
          }
        }'
}

header=0
definitions=
while [ $# -gt 0 ]; do
    case $1 in
        --header) header=1; shift ;;
        --define)
            [ $# -ge 2 ] || {
                printf '%s\n' 'maelys-cli-embed: --define needs NAME=VALUE' >&2
                exit 64
            }
            case $2 in
                *=*) ;;
                *)
                    printf '%s\n' 'maelys-cli-embed: --define needs NAME=VALUE' >&2
                    exit 64
                    ;;
            esac
            name=${2%%=*}
            value=${2#*=}
            case $name in
                *[!A-Za-z0-9_]*|[0-9]*|'')
                    printf "maelys-cli-embed: invalid define name '%s'\n" "$name" >&2
                    exit 64
                    ;;
            esac
            pattern=$(printf '@%s@' "$name" | encode_bytes)
            replacement=$(printf '%s' "$value" | encode_bytes)
            [ -z "$definitions" ] || definitions="$definitions;"
            definitions="$definitions$pattern|$replacement"
            shift 2
            ;;
        --) shift; break ;;
        -*) printf 'maelys-cli-embed: unknown option %s\n' "$1" >&2; exit 64 ;;
        *) break ;;
    esac
done
[ $# -gt 0 ] || {
    printf '%s\n' 'usage: maelys-cli-embed [--header] [--define NAME=VALUE]... SYMBOL=FILE...' >&2
    exit 64
}

printf '/* GENERATED by maelys-cli-embed; do not edit. */\n\n'
for pair in "$@"; do
    case $pair in
        *=*) ;;
        *) printf "maelys-cli-embed: expected SYMBOL=FILE, got '%s'\n" "$pair" >&2; exit 64 ;;
    esac
    symbol=${pair%%=*}
    file=${pair#*=}
    case $symbol in
        *[!A-Za-z0-9_]*|[0-9]*|'')
            printf "maelys-cli-embed: invalid symbol '%s'\n" "$symbol" >&2
            exit 64
            ;;
    esac
    [ -f "$file" ] || {
        printf 'maelys-cli-embed: %s is not a regular file\n' "$file" >&2
        exit 66
    }
    if [ "$header" -eq 1 ]; then
        printf 'extern const char %s[];\n' "$symbol"
        continue
    fi
    printf 'const char %s[] = {\n' "$symbol"
    LC_ALL=C od -An -v -tu1 "$file" | \
        MAELYS_CLI_EMBED_DEFINITIONS="$definitions" LC_ALL=C awk '
        BEGIN {
            encoded = ENVIRON["MAELYS_CLI_EMBED_DEFINITIONS"]
            definition_count = encoded == "" ? 0 : split(encoded, definition, ";")
            for (d = 1; d <= definition_count; d++) {
                split(definition[d], halves, "|")
                pattern_length[d] = split(halves[1], values, ",")
                for (j = 1; j <= pattern_length[d]; j++)
                    pattern[d, j] = values[j]
                replacement_length[d] = 0
                if (halves[2] != "") {
                    replacement_length[d] = split(halves[2], values, ",")
                    for (j = 1; j <= replacement_length[d]; j++)
                        replacement[d, j] = values[j]
                }
            }
        }
        { for (i = 1; i <= NF; i++) bytes[++byte_count] = $i }
        END {
            for (d = 1; d <= definition_count; d++) {
                next_count = 0
                for (i = 1; i <= byte_count;) {
                    matches = i + pattern_length[d] - 1 <= byte_count
                    for (j = 1; matches && j <= pattern_length[d]; j++)
                        if (bytes[i + j - 1] != pattern[d, j]) matches = 0
                    if (matches) {
                        for (j = 1; j <= replacement_length[d]; j++)
                            next_bytes[++next_count] = replacement[d, j]
                        i += pattern_length[d]
                    } else {
                        next_bytes[++next_count] = bytes[i++]
                    }
                }
                for (i = 1; i <= byte_count; i++) delete bytes[i]
                byte_count = next_count
                for (i = 1; i <= byte_count; i++) {
                    bytes[i] = next_bytes[i]
                    delete next_bytes[i]
                }
            }
            for (i = 1; i <= byte_count; i++) {
                printf "%s,", bytes[i]
                if (i % 20 == 0) printf "\n"
            }
            printf "0 };\n\n"
        }'
done
