#!/bin/sh
# Embeds files (JSON Schemas, Markdown, any text) into C symbols so a CLI
# binary stays self-contained.
#
# usage: maelys-cli-embed [--header] [--define NAME=VALUE]... SYMBOL=FILE...
#
# Without --header, prints definitions:  const char SYMBOL[] = { ..., 0 };
# With --header, prints declarations:    extern const char SYMBOL[];
# --define replaces every @NAME@ occurrence in the files before embedding.
set -eu

header=0
sed_script=''
while [ $# -gt 0 ]; do
    case $1 in
        --header) header=1; shift ;;
        --define)
            [ $# -ge 2 ] || { echo "maelys-cli-embed: --define needs NAME=VALUE" >&2; exit 64; }
            name=${2%%=*}
            value=${2#*=}
            sed_script="$sed_script -e s|@$name@|$value|g"
            shift 2 ;;
        --) shift; break ;;
        -*) echo "maelys-cli-embed: unknown option $1" >&2; exit 64 ;;
        *) break ;;
    esac
done
[ $# -gt 0 ] || { echo "usage: maelys-cli-embed [--header] [--define NAME=VALUE]... SYMBOL=FILE..." >&2; exit 64; }

printf '/* GENERATED by maelys-cli-embed; do not edit. */\n\n'
for pair in "$@"; do
    symbol=${pair%%=*}
    file=${pair#*=}
    case $symbol in
        *[!A-Za-z0-9_]*|[0-9]*|'') echo "maelys-cli-embed: invalid symbol '$symbol'" >&2; exit 64 ;;
    esac
    [ -f "$file" ] || { echo "maelys-cli-embed: $file is not a regular file" >&2; exit 66; }
    if [ "$header" -eq 1 ]; then
        printf 'extern const char %s[];\n' "$symbol"
        continue
    fi
    printf 'const char %s[] = {\n' "$symbol"
    if [ -n "$sed_script" ]; then
        # shellcheck disable=SC2086
        sed $sed_script "$file"
    else
        cat "$file"
    fi | od -An -v -tu1 | awk '
        { for (i = 1; i <= NF; i++) { printf "%s,", $i; if (++n % 20 == 0) printf "\n" } }
        END { printf "0 };\n\n" }'
done
