def escape(text: str) -> str:
    """Text safe in a roff line: a backslash written as itself, a minus as
    the character a reader copies into a shell, a character outside ASCII
    as its escape (\\[u00E9]), which groff and mandoc both read and which
    keeps the source ASCII, and no line read as a request."""
    text = text.replace("\\", "\\e").replace("-", "\\-")
    text = "".join(c if ord(c) < 0x80 else f"\\[u{ord(c):04X}]" for c in text)
    return "\\&" + text if text[:1] in (".", "'") else text


def prose(words: str) -> list[str]:
    """Escaped text as source lines of at most 80 bytes, broken between
    words: roff joins them again, and a reviewer reads the source."""
    return wrap(escape(words))


def wrap(escaped: str) -> list[str]:
    """Text already escaped, as prose() breaks it."""
    lines: list[str] = []
    for word in escaped.split(" "):
        if lines and len(lines[-1]) + 1 + len(word) <= 80:
            lines[-1] += " " + word
        else:
            lines.append(word)
    return ["\\&" + line if line[:1] in (".", "'") else line for line in lines if line]


def paragraphs(text: str) -> list[str]:
    """The paragraphs of a prose member: each of its lines is one, as the
    help reads it; blank lines are dropped, roff separates paragraphs."""
    return [line.strip() for line in text.split("\n") if line.strip()]


def shell_word(word: str) -> str:
    """A word spelled as a shell reads it back, as the help writes an
    example (C: help_shell_words)."""
    if word and re.fullmatch(r"[A-Za-z0-9_@%+=:,./-]+", word):
        return word
    return "'" + word.replace("'", "'\\''") + "'"


def effect_sentence(command: dict, tr: Translator) -> str | None:
    """What changes what the reader types, in the words of the help."""
    effect = command["effect"]
    if command.get("external"):
        return tr("The rest of the line goes to another program, word for word.")
    if isinstance(effect, dict):
        return tr("It shows a plan; --apply commits it." if effect.get("apply") == "commit"
                  else "It shows a plan; --apply applies it.")
    if effect == "execute":
        return tr("It acts at once, without a plan.")
    if effect == "stream" and command.get("protocol"):
        return tr.format("Its output is the %s protocol: --format and the other rendering options do not apply.",
                         command["protocol"])
    if effect == "stream":
        return tr("Its output is its own: --format and the other rendering options do not apply.")
    return None


def option_label(item: dict, tr: Translator) -> str:
    value = item.get("argument")
    if value and value.get("choices"):
        spelled = f"{item['long']} {'|'.join(value['choices'])}"
    elif value:
        spelled = f"{item['long']} {value.get('name', 'VALUE')}"
    else:
        spelled = item["long"]
    return spelled + (" " + tr("(repeatable)") if item.get("repeatable") else "")


def dashed(template: str, name: str, tr: Translator) -> str:
    """"Requires --%s." for an option, as the help names it, "Requires %s." for an operand."""
    return tr.format(template.replace("%s", "--%s"), name[2:]) if name.startswith("--") else tr.format(template, name)


def option_text(item: dict, tr: Translator) -> str:
    text = tr(item.get("summary", ""))
    if "default" in item:
        text += " " + tr.format("Default: %s.", item["default"])
    if item.get("required"):
        text += " " + tr("Required.")
    text += "".join(" " + dashed("Requires %s.", name, tr) for name in item.get("requires", []))
    text += "".join(" " + dashed("Conflicts with %s.", name, tr) for name in item.get("conflictsWith", []))
    return text


def blocks(data: dict, date: str, tr: Translator) -> list[tuple]:
    """The page as a list of blocks, the same for every format: what the page says, in its order. A
    block is (kind, ...): title, section (key, heading), subsection, name (program, summary), synopsis
    (program, words), para, usage (program, usage), entry (label, text) and example (line)."""
    program = data["program"]
    # The product's commands first, then the ones every program has (section 6 of the contract), as the
    # help lists them.
    built_in = {"help", "version", "describe", "completion", "complete.candidates", "completion.install"}
    visible = [command for command in data["commands"] if not command.get("hidden")]
    shown = [command for command in visible if command["id"] not in built_in] + \
        [command for command in visible if command["id"] in built_in]
    by_id = {command["id"]: command for command in data["commands"]}
    out: list[tuple] = [("title", program, data["product"], data["version"], tr.format("%s Manual", data["product"]),
                         date)]
    out += [("section", "name", tr("NAME")), ("name", program, tr(data.get("x-maelys-summary") or data["product"]))]
    out += [("section", "synopsis", tr("SYNOPSIS")), ("synopsis", program, "COMMAND [OPERANDS] [options]")]
    default = by_id.get(data.get("defaultCommand", ""))
    if default is not None:
        out += [("synopsis", program, "[options] [-- OPERANDS]")]
    out += [("section", "description", tr("DESCRIPTION")),
            ("para", tr.format("%s %s, a program of the agent-cli/v2 contract: '%s help' shows the help, "
                               "'%s describe --format json' the catalog this page is rendered from.",
                               data["product"], data["version"], program, program))]
    if default is not None:
        pattern = " ".join(default["pattern"])
        out += [("para", tr.format("%s [options] runs '%s', as %s %s [options] does: the options in front, "
                                   "other than --help and --version, are its, and its operands come after --.",
                                   program, pattern, program, pattern))]
    out += [("section", "commands", tr("COMMANDS"))]
    for command in shown:
        out += [("subsection", " ".join(command["pattern"])), ("usage", program, command["usage"])]
        sentence = effect_sentence(command, tr)
        out += [("para", tr(command["purpose"]) + (f" {sentence}" if sentence else ""))]
        if command.get("available") is False:
            out += [("para", tr.format("Not available in this build: %s", tr(command.get("unavailableReason", ""))))]
        for item in command["input"].get("operands", []):
            out += [("entry", item["name"], tr(item.get("summary", "")) + ("" if item.get("required")
                                                                           else " " + tr("Optional.")))]
        for item in command["input"].get("options", []):
            if not item.get("hidden"):
                out += [("entry", option_label(item, tr), option_text(item, tr))]
    out += [("section", "global-options", tr("GLOBAL OPTIONS"))]
    for item in data.get("globalOptions", []):
        if not item.get("hidden"):
            out += [("entry", option_label(item, tr), option_text(item, tr))]
    examples = [item for command in shown for item in command.get("examples", [])]
    if examples:
        out += [("section", "examples", tr("EXAMPLES"))]
        for item in examples:
            # A line to copy stays one line, as in the help, whatever its length.
            out += [("para", tr(item.get("summary", ""))),
                    ("example", f"{program} {' '.join(shell_word(word) for word in item['words'])}")]
    out += [("section", "exit-status", tr("EXIT STATUS"))]
    codes = next((command.get("exitCodes") for command in data["commands"] if command.get("exitCodes")),
                 {"0": "command completed", "1": "execution failed", "2": "valid report with violations"})
    for code in sorted(codes, key=int):
        out += [("entry", code, tr(codes[code].capitalize() + "."))]
    if any(command["effect"] == "stream" or command.get("external") for command in shown):
        out += [("para", tr("A stream command and a delegate exit with the status of what they run."))]
    out += [("section", "environment", tr("ENVIRONMENT"))]
    for name, text in ENVIRONMENT:
        out += [("entry", name, tr(text))]
    guidance = data.get("x-maelys-guidance")
    if guidance:
        out += [("section", "notes", tr("NOTES"))]
        out += [("para", paragraph) for paragraph in paragraphs(tr(guidance))]
    out += [("section", "see-also", tr("SEE ALSO")),
            ("para", f"{program} help, {program} help COMMAND, {program} describe --format json")]
    return out


def roff(page: list[tuple]) -> str:
    """The page in roff, man(7), section 1. A paragraph follows a heading directly and any other block
    after a .PP; an example is a line to copy, indented and never filled."""
    lines: list[str] = []
    previous = None
    for block in page:
        kind = block[0]
        if kind == "title":
            _, program, product, version, manual, date = block
            lines.append(f'.TH {escape(program.upper())} 1 {date} "{escape(product)} {escape(version)}"'
                         f' "{escape(manual)}"')
        elif kind == "section":
            lines.append(f".SH {block[2]}")
        elif kind == "subsection":
            lines.append(f'.SS "{escape(block[1])}"')
        elif kind == "name":
            lines += wrap(f"{escape(block[1])} \\- {escape(block[2])}")
        elif kind == "synopsis":
            lines += ([".br"] if previous == "synopsis" else []) + [f".B {escape(block[1])}", *prose(block[2])]
        elif kind == "usage":
            lines += [f".B {escape(block[1])}", *prose(block[2])]
        elif kind == "para":
            lines += ([] if previous in ("section", "subsection") else [".PP"]) + prose(block[1])
        elif kind == "entry":
            lines += [".TP", f".B {escape(block[1])}", *prose(block[2])]
        elif kind == "example":
            lines += [".PP", ".RS 4", ".nf", escape(block[1]), ".fi", ".RE"]
        previous = kind
    return "\n".join(lines) + "\n"


def mdx_text(text: str) -> str:
    """Prose safe in MDX: no character read as JSX, an expression or Markdown markup."""
    # Markdown first, then the entities, whose `#` must stay as written.
    text = re.sub(r"([\\*_`\[\]#|])", r"\\\1", text)
    text = text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
    return text.replace("{", "&#123;").replace("}", "&#125;")


def mdx_code(text: str) -> str:
    """An inline code span holding `text` whatever backticks it carries."""
    fence = "`" * (max((len(run) for run in re.findall(r"`+", text)), default=0) + 1)
    pad = " " if text.startswith("`") or text.endswith("`") else ""
    return f"{fence}{pad}{text}{pad}{fence}"


def mdx(page: list[tuple], body_only: bool = False) -> str:
    """The page in MDX for a documentation site: the same blocks as the manual page, headings in sentence
    case, a command line in a code block, an option or an operand as an item of a list. The site owns
    the frontmatter, the navigation and its components; with `body_only` the title is left to it too."""
    chunks: list[str] = []
    for block in page:
        kind = block[0]
        last = chunks[-1] if chunks else ""
        if kind == "title":
            if not body_only:
                chunks.append(f"# {mdx_text(block[1])}")
        elif kind == "section":
            if block[1] != "name":       # the title names the program; its summary leads the page
                heading = block[2][:1].upper() + block[2][1:].lower()
                chunks.append(f"## {mdx_text(heading)}")
        elif kind == "subsection":
            chunks.append(f"### {mdx_code(block[1])}")
        elif kind == "name":
            chunks.append(mdx_text(block[2]))
        elif kind == "synopsis":
            line = f"{block[1]} {block[2]}"
            if last.startswith("```sh\n") and last.endswith("\n```") and chunks[-2].startswith("## "):
                chunks[-1] = last[:-3] + f"{line}\n```"   # keep the newline before the fence
            else:
                chunks.append(f"```sh\n{line}\n```")
        elif kind == "usage" or kind == "example":
            line = f"{block[1]} {block[2]}" if kind == "usage" else block[1]
            chunks.append(f"```sh\n{line}\n```")
        elif kind == "para":
            chunks.append(mdx_text(block[1]))
        elif kind == "entry":
            item = f"- {mdx_code(block[1])}: {mdx_text(block[2])}"
            if last.startswith("- "):
                chunks[-1] = f"{last}\n{item}"
            else:
                chunks.append(item)
    return "\n\n".join(chunks) + "\n"


def translator(data: dict, tag: str | None) -> Translator:
    """The texts of the page for --lang TAG: the product's table for the language it declares, and the
    framework's for the same language. Without --lang, or for its canonical language or one it does not
    declare, the page is in the canonical language the catalog is written in (`canonical`, English when
    absent), the framework's texts following it."""
    declared = data.get("x-maelys-translations")
    declared = declared if isinstance(declared, dict) and declared.get("version") == 1 else {}
    canonical = declared.get("canonical") or "en"
    languages = declared.get("languages", {})
    found = lookup(tag, [canonical, *languages]) if tag else None
    if found is None:
        found = canonical
    framework = lookup(found, list(_FRAMEWORK_TRANSLATIONS))
    return Translator(None if found == canonical else languages[found],
                      _FRAMEWORK_TRANSLATIONS[framework] if framework else {})


USAGE = ("usage: maelys-cli-man [--date YYYY-MM-DD] [--lang TAG] [--untranslated] [--format roff|mdx] "
         "[--body-only]\n                      (PROGRAM [WORD...] | --catalog FILE [--version VERSION] PROGRAM)\n")


def catalog_file(path: str, program: str) -> dict:
    """The catalog of `program` in a file: the envelope `describe --format json` writes, or the aggregate
    contract of maelys-cli-reference (docs/cli-contract.json, {"contract", "programs": {NAME: catalog}})."""
    with open(path, encoding="utf-8") as stream:
        source = json.load(stream)
    if "programs" in source:
        data = source["programs"].get(program)
    else:
        data = source.get("data", source)
    if not isinstance(data, dict) or data.get("program") != program or not isinstance(data.get("commands"), list):
        raise ValueError(f"{path} holds no catalog of {program}")
    return data


def main(argv: list[str]) -> int:
    date = None
    tag = None
    untranslated = False
    body_only = False
    form = "roff"
    catalog = None
    version = None
    while argv[:1] in (["--date"], ["--lang"], ["--untranslated"], ["--format"], ["--body-only"], ["--catalog"],
                       ["--version"]):
        if argv[0] in ("--untranslated", "--body-only"):
            untranslated, body_only = untranslated or argv[0] == "--untranslated", body_only or argv[0] == "--body-only"
            argv = argv[1:]
            continue
        if len(argv) < 2:
            break
        name, value, argv = argv[0], argv[1], argv[2:]
        if name == "--date":
            date = value
            if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", date):
                sys.stderr.write("maelys-cli-man: --date takes YYYY-MM-DD\n")
                return 1
        elif name == "--lang":
            tag = value
            if not LANGUAGE_TAG.fullmatch(tag):
                sys.stderr.write("maelys-cli-man: --lang takes a tag language[-Script][-REGION], such as fr or fr-CA\n")
                return 1
        elif name == "--format":
            form = value
            if form not in ("roff", "mdx"):
                sys.stderr.write("maelys-cli-man: --format takes roff or mdx\n")
                return 1
        elif name == "--catalog":
            catalog = value
        else:
            version = value
    if not argv or argv[0].startswith("-") or (untranslated and tag is None) or (body_only and form != "mdx") \
            or (catalog is not None and len(argv) != 1) or (version is not None and catalog is None):
        sys.stderr.write(USAGE + "--untranslated needs --lang, --body-only --format mdx, --version --catalog.\n")
        return 1
    if date is None:
        epoch = os.environ.get("SOURCE_DATE_EPOCH")
        moment = datetime.datetime.fromtimestamp(int(epoch), datetime.timezone.utc) if epoch else \
            datetime.datetime.now(datetime.timezone.utc)
        date = moment.strftime("%Y-%m-%d")
    if catalog is not None:
        # A file, as a site reads it at the tag it documents: no program is run.
        try:
            data = catalog_file(catalog, argv[0])
        except (OSError, ValueError, AttributeError) as error:
            sys.stderr.write(f"maelys-cli-man: {error}\n")
            return 1
        if version is not None:
            data = dict(data, version=version)
        if not data.get("version"):
            sys.stderr.write(f"maelys-cli-man: {catalog} names no version of {argv[0]}: pass --version\n")
            return 1
    else:
        environment = dict(os.environ, NO_COLOR="1")
        environment.pop("MAELYS_CLI_FORMAT", None)
        completed = subprocess.run([*argv, "describe", "--format", "json", "--compact", "--non-interactive"],
                                   stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=environment,
                                   check=False)
        try:
            envelope = json.loads(completed.stdout)
            data = envelope["data"]
            if envelope.get("ok") is not True or data.get("kind") != "catalog":
                raise ValueError("not a catalog")
        except (ValueError, KeyError, TypeError):
            sys.stderr.write(f"maelys-cli-man: {' '.join(argv)} gave no describe catalog\n{completed.stderr}")
            return 1
    tr = translator(data, tag)
    page = blocks(data, date, tr)
    if untranslated:
        # Only the product's texts: the framework's own are its table's business.
        framework = set().union(*(table for table in _FRAMEWORK_TRANSLATIONS.values())) if _FRAMEWORK_TRANSLATIONS \
            else set()
        sys.stdout.write("".join(f"{source}\n" for source in tr.missed if source not in framework))
        return 0
    sys.stdout.write(mdx(page, body_only) if form == "mdx" else roff(page))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
