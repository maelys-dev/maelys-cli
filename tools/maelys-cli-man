LANGUAGE_TAG = re.compile(r"[A-Za-z]{2,3}(-[A-Za-z]{4})?(-([A-Za-z]{2}|[0-9]{3}))?")


def lookup(tag: str, available: list) -> str | None:
    """RFC 4647 Lookup, as the runtime does it (c/src/language.c)."""
    subtags = tag.split("-")
    while subtags:
        wanted = "-".join(subtags).lower()
        found = next((language for language in available if language.lower() == wanted), None)
        if found is not None:
            return found
        subtags.pop()
        if subtags and len(subtags[-1]) == 1:
            subtags.pop()
    return None


class Translator:
    """The texts of the page in one language: the product's table, then the framework's, then English. It
    remembers the texts it left in English."""

    def __init__(self, product: dict | None, framework: dict) -> None:
        # product is None in the canonical language, which has no table and lacks nothing.
        self.translating = product is not None
        self.tables = [table for table in (product, framework) if table]
        self.missed: list[str] = []

    def __call__(self, source: str) -> str:
        for table in self.tables:
            if source in table:
                return table[source]
        if self.translating and source and source not in self.missed:
            self.missed.append(source)
        return source

    def format(self, template: str, *arguments: str) -> str:
        """A template translated before its %s are filled, in order."""
        pieces = re.split(r"(%%|%s)", self(template))
        values = iter(arguments)
        return "".join("%" if piece == "%%" else next(values) if piece == "%s" else piece for piece in pieces)

